@flow submit-and-wait trigger="DGXClient.submit followed by await DGXJob.wait" path=[validate-notebook,detect-platform-and-openvpn,connect-vpn,connect-ssh,build-bundle,upload-bundle,sbatch,persist-job,stream-logs,poll-status,download-outputs] fail={invalid-input:BundleError,vpn:VPNError,ssh:SSHError,scheduler:SchedulerError} inv=[safe-includes,no-secret-persistence,terminal-state-contract,incremental-logs] test=list[path]:[tests/test_integration.py] evidence=list[path]:[src/dgx_slurm/client.py,src/dgx_slurm/job.py]
@flow run-notebook trigger="run_notebook or run_notebook_async" path=[validate-vpn-directory,infer-username,select-project-files,create-temp-bundle,submit-and-wait,copy-executed-notebook,cleanup-connections] fail={configuration:ConfigurationError,execution:NotebookExecutionError} inv=[safe-includes,no-secret-persistence,connection-ownership,partial-notebook] test=list[path]:[tests/test_workflow.py] evidence=list[path]:[src/dgx_slurm/workflow.py,README.md]
@flow release-binaries trigger="push of a v* tag or manual GitHub Actions dispatch" path=[run-unit-tests,install-compatible-macos-crypto-wheel,build-linux-binary,build-windows-exe,build-macos-arm64-pkg,build-macos-x86_64-pkg,smoke-test-artifacts,publish-tagged-release] fail={test:workflow-failure,build:workflow-failure,release:workflow-failure} inv=[tagged-release-only,frozen-templates-complete] test=list[path]:[tests/test_cli.py,tests/test_release_workflow.py] evidence=list[path]:[.github/workflows/release.yml,pyinstaller-hooks/hook-dgx_slurm.py]
@flow execute-notebook trigger="SLURM runs generated runImage.slurm" path=[docker-build,docker-run,execute-cells,write-executed-notebook,remove-job-image] fail={build:nonzero,cell-error:nonzero} inv=[partial-notebook,image-scoped-cleanup] test=list[path]:[tests/test_execute_notebook.py,tests/test_slurm_template.py] evidence=list[path]:[src/dgx_slurm/templates/runImage.slurm,src/dgx_slurm/templates/execute_notebook.py]

@contract bundle-layout type=file owner=bundling source=src/dgx_slurm/bundle.py fields=list[id]:[payload,runner,outputs,logs,Dockerfile,runImage.slurm,manifest.json] risk=set[enum]:[security,secret-leak] test=list[path]:[tests/test_bundle.py,tests/test_dockerfile.py]
@contract local-job-store type=file owner=persistence source=src/dgx_slurm/storage.py fields=list[id]:[job-id,job-name,remote-job-dir] risk=set[enum]:[corrupt-state] test=list[path]:[tests/test_client.py]
@contract slurm-cli type=cli owner=scheduling source=src/dgx_slurm/slurm.py fields=list[id]:[sbatch,squeue,sacct,scontrol,scancel] risk=set[enum]:[remote-execution] test=list[path]:[tests/test_slurm.py]

@inv safe-includes scope=bundling severity=critical rule="Included files must resolve inside project_root; credential-like suffixes and ignored directories must never enter the uploaded payload." evidence=list[path]:[src/dgx_slurm/bundle.py,tests/test_bundle.py]
@inv no-secret-persistence scope=orchestration severity=critical rule="Passwords, VPN contents, private-key material, authentication temp paths, and environment dumps must not be persisted, bundled, or exposed in errors." evidence=list[path]:[src/dgx_slurm/errors.py,src/dgx_slurm/storage.py,src/dgx_slurm/bundle.py,tests/test_bundle.py,tests/test_vpn.py]
@inv ephemeral-vpn-credentials scope=connectivity severity=critical rule="OpenVPN credentials live only in memory and in a temporary 0700 directory with a 0600 auth file, removed after connection success or failure." evidence=list[path]:[src/dgx_slurm/vpn.py,tests/test_vpn.py]
@inv strict-host-keys scope=connectivity severity=high rule="SSH must load known hosts and reject unknown host keys by default." evidence=list[path]:[src/dgx_slurm/ssh.py,tests/test_ssh.py]
@inv connection-ownership scope=connectivity severity=high rule="Disconnect must terminate only the OpenVPN process started by this library; an already reachable external VPN is not owned." evidence=list[path]:[src/dgx_slurm/vpn.py,tests/test_vpn.py]
@inv incremental-logs scope=scheduling severity=medium rule="Remote stdout and stderr are read from independent byte offsets so streamed chunks are accumulated and echoed at most once." evidence=list[path]:[src/dgx_slurm/streaming.py,tests/test_streaming.py]
@inv terminal-state-contract scope=scheduling severity=high rule="DGXJob.wait returns only after a terminal JobState and performs one final log poll before optional output download." evidence=list[path]:[src/dgx_slurm/job.py,src/dgx_slurm/models.py,tests/test_job.py]
@inv partial-notebook scope=bundling severity=high rule="The runner always writes the executed or partially executed notebook, including when a cell raises an execution error." evidence=list[path]:[src/dgx_slurm/templates/execute_notebook.py,tests/test_execute_notebook.py]
@inv image-scoped-cleanup scope=bundling severity=high rule="SLURM cleanup removes only the image tagged for the current job, preserves the job exit code, and never runs docker system prune." evidence=list[path]:[src/dgx_slurm/templates/runImage.slurm,tests/test_slurm_template.py]
@inv gui-work-is-off-the-event-loop scope=desktop-ui severity=high rule="Every submission or collection runs on the window's single worker thread; the password is asked on the GUI thread before that thread starts, and the host-key question is marshalled back through the message queue. Both screens are disabled while the worker is alive so a second job cannot race the first." evidence=list[path]:[src/dgx_slurm/gui.py,tests/test_gui.py]
@inv gui-mirrors-cli-hygiene scope=desktop-ui severity=high rule="Collection from the window always passes save_logs=True and keep_remote=4, matching --collect-even-error and the --keep-remote default. The window is for people who should not have to reason about cluster housekeeping, and for a failed job the log IS the artefact." evidence=list[path]:[src/dgx_slurm/gui.py,tests/test_gui.py]
@inv frozen-templates-complete scope=orchestration severity=high rule="The frozen executable ships every file under src/dgx_slurm/templates/, including .py runner templates that PyInstaller's --collect-data silently skips." evidence=list[path]:[pyinstaller-hooks/hook-dgx_slurm.py,tests/test_release_workflow.py] enforce="pyinstaller --additional-hooks-dir pyinstaller-hooks"
@inv tagged-release-only scope=orchestration severity=high rule="Manual workflow runs may build downloadable artifacts, but a persistent GitHub Release is published only for an existing v* Git tag after every platform build succeeds." evidence=list[path]:[.github/workflows/release.yml]
@inv gpu-allocation-respected scope=bundling severity=high rule="The rendered SLURM script must pass the SLURM-allocated GPU list to docker run, never --gpus all. Observed in production: a job requesting 4 GPUs saw all 8 on the node and could have used devices allocated to another user. CUDA_VISIBLE_DEVICES is cgroup-local (0..N-1 under ConstrainDevices) while the docker daemon reads host indices, so jobs 12483/12484 (IDX 0-1 and 2-3) both ran on host GPUs 0-1 and 12483 died of OOM; the template therefore translates the local indices to GPU UUIDs with nvidia-smi inside the allocation, falling back to the global SLURM_JOB_GPUS/SLURM_STEP_GPUS and only then to the local list. docker run is backgrounded and awaited so a scancel TERM runs the cleanup trap (docker rm -f) at once; in the foreground the trap waited for the docker client, SIGKILL arrived first and the 12484 container outlived its allocation. The template assembles the flag in a bash array rather than through eval, because the job path reaches --mount and would break on spaces." evidence=list[path]:[src/dgx_slurm/templates/runImage.slurm,tests/test_slurm_template.py]
@inv slurm-memory-flag-omitted scope=scheduling severity=high rule="Rendered job scripts must not emit #SBATCH --mem because this cluster rejects the memory flag." evidence=list[path]:[src/dgx_slurm/templates/runImage.slurm]
@inv payload-not-retained scope=bundling severity=medium rule="The job cleanup trap deletes payload/ and runner/ when the container exits, alongside the image. The payload is a copy of files the user already holds locally and a data-carrying bundle can exceed hundreds of megabytes, one directory per submission. Logs, outputs and the manifest MUST survive: a --collect-results run happens afterwards, sometimes much later." evidence=list[path]:[src/dgx_slurm/templates/runImage.slurm,tests/test_slurm_template.py]
@inv failure-diagnostics-persisted scope=orchestration severity=high rule="Collection writes the job stdout and stderr to job.out and job.err under --collect-even-error. download_outputs fetches only outputs/, so a job dying before producing output yields an empty results directory while the only diagnostic exists solely on the console -- and the VPN drops immediately after collection. For a failed job the log IS the artefact." evidence=list[path]:[src/dgx_slurm/workflow.py,tests/test_cli.py]
@inv remote-prune-is-bounded scope=orchestration severity=high rule="prune_remote_jobs operates exclusively inside DEFAULT_REMOTE_BASE_DIR, keeps the N most recent job directories and never removes the one just collected, since collecting an old job must not delete it. It is reachable only through --keep-remote, whose 0 disables removal entirely." evidence=list[path]:[src/dgx_slurm/client.py,tests/test_client.py]

@task establish-aicp owner=orchestration status=done goal="Add a repository-level AICP semantic and navigation manifest." touch=list[path]:[AICP.aicp] avoid=list[glob]:[]
@task cluster-hygiene owner=orchestration status=done goal="Keep failures diagnosable and stop the cluster home from filling up." touch=list[path]:[src/dgx_slurm/cli.py,src/dgx_slurm/workflow.py,src/dgx_slurm/client.py,src/dgx_slurm/templates/runImage.slurm,tests/test_cli.py,tests/test_client.py,tests/test_slurm_template.py] note="Four consecutive jobs failed with an empty results directory and no log, which turned out to be the compute nodes not mounting /home -- but the submitter gave no way to see that, because logs were streamed to the console and never persisted. Adds --collect-even-error, --keep-remote, payload cleanup in the job trap, and makes docker honour the SLURM GPU allocation."

@task gui-parity owner=desktop-ui status=done goal="Bring the window up to the CLI: detached submission and a collection screen." touch=list[path]:[src/dgx_slurm/gui.py,src/dgx_slurm/storage.py,src/dgx_slurm/workflow.py,src/dgx_slurm/cli.py,tests/test_gui.py,tests/test_client.py,tests/test_workflow.py,tests/test_cli.py,README.md] note="The window still ran only the original synchronous flow, so --async, --collect-results, --collect-even-error and --keep-remote existed solely in the terminal. Splits the window into a Enviar tab and a Coletar resultados tab, adds LocalJobStore.list_all and a submitted_at stamp to order the list, and fixes a missing ConfigurationError import that made the CLI raise NameError when run with no arguments."
@task macos-gui owner=desktop-ui status=todo goal="Ship the window on macOS." touch=list[path]:[.github/workflows/release.yml] note="gui.py is already cross-platform tkinter, but the macOS job builds only the console binary into a .pkg, so Mac users are terminal-only. Needs a --windowed PyInstaller build producing a .app inside the .pkg. Unsigned and un-notarised, so Gatekeeper will need a manual override."
@risk gui-tests-skip-silently level=medium scope=set[id]:[desktop-ui] mitigation="tests/test_gui.py skips its widget tests when Tk or a display is missing, which is always true on the CI runner. Run them on a desktop machine before trusting a GUI change." evidence=list[path]:[tests/test_gui.py,.github/workflows/release.yml]
@risk explicit-cluster-configuration level=low scope=set[id]:[orchestration,examples] mitigation="VPN directory, SSH host, SSH port, partition, GPU, CPU, memory, and time limit are mandatory at every high-level call; username inference remains overridable." evidence=list[path]:[src/dgx_slurm/client.py,src/dgx_slurm/workflow.py,README.md]
@risk remote-command-boundary level=high scope=set[id]:[connectivity,scheduling] mitigation="Keep remote commands library-constructed and shell-quote every dynamic path or identifier." evidence=list[path]:[src/dgx_slurm/ssh.py,src/dgx_slurm/slurm.py,src/dgx_slurm/client.py]
@risk cluster-test-environment level=medium scope=set[id]:[examples,scheduling] mitigation="Keep real-cluster smoke tests opt-in and use unit/integration tests plus local_dry_run for routine validation." evidence=list[path]:[tests/test_cluster_smoke.py,examples/README.md]
@risk stale-context level=medium scope=set[id]:[global] mitigation="Update AICP when public surfaces, module boundaries, bundle contracts, cluster flow, invariants, or verification commands change."
@inv vpn-ownership scope=set[id]:[connectivity,orchestration] rule="A tunnel the process did not open is never torn down. --keep-vpn additionally leaves a tunnel this process opened running so the next invocation reuses it through VPNConnection.connect is_reachable short circuit, skipping the handshake and the sudo prompt; the VPN and SSH share one credential, so the prompt itself is only avoidable with an SSH key" evidence=list[path]:[src/dgx_slurm/vpn.py,src/dgx_slurm/client.py] test=list[path]:[tests/test_client.py]
