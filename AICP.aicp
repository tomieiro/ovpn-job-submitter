@aicp v=semver:0.3.0 id=dgx-slurm kind=library summary="Python library for submitting Jupyter notebooks to a SLURM-managed DGX cluster over OpenVPN, SSH, and Docker."
@stack lang=set[enum]:[python,bash,dockerfile] runtime=set[enum]:[cpython,openvpn,ssh,slurm,docker,jupyter] infra=set[enum]:[dgx,cuda] package=list[path]:[pyproject.toml] lock=list[path]:[]
@agent read=list[atom]:[@aicp,@stack,@cmd,@mod,@surface,@resolver,@flow,@contract,@inv,@task,@risk] verify=bool:true update_on_arch_change=bool:true max_context_ratio=float:0.05 mode=guided
@avoid paths=list[glob]:[.git/**,.venv/**,.pytest_cache/**,__pycache__/**,*.egg-info/**,build/**,dist/**,.dgx-results/**,examples/.dgx-results/**] reason="Generated, cached, environment, or downloaded-result content."

@cmd setup "python -m pip install -e '.[dev]'"
@cmd test "python -m pytest"
@cmd test-unit "python -m pytest -m 'not cluster'"
@cmd local-smoke "python examples/local_dry_run.py"
@cmd cluster-smoke "DGX_SMOKE_OVPN=/path/client.ovpn DGX_SMOKE_USERNAME=user python -m pytest -m cluster -s"

@mod orchestration kind=core owns=set[id]:[client,job-lifecycle,public-api] entry=list[path]:[src/dgx_slurm/client.py,src/dgx_slurm/job.py,src/dgx_slurm/__init__.py] deps=set[nsid]:[bundling,connectivity,scheduling,persistence] risk=set[enum]:[runtime,resource-lifecycle] test=list[path]:[tests/test_client.py,tests/test_job.py,tests/test_integration.py] evidence=list[path]:[src/dgx_slurm/client.py,src/dgx_slurm/job.py]
@mod models kind=lib owns=set[id]:[resources,job-state,job-status,job-result,errors] entry=list[path]:[src/dgx_slurm/models.py,src/dgx_slurm/errors.py] deps=set[id]:[] risk=set[enum]:[validation] test=list[path]:[tests/test_models.py] evidence=list[path]:[src/dgx_slurm/models.py,src/dgx_slurm/errors.py]
@mod bundling kind=core owns=set[id]:[notebook-validation,include-copy,bundle-layout,slurm-rendering,container-runner] entry=list[path]:[src/dgx_slurm/bundle.py,src/dgx_slurm/templates/] deps=set[id]:[models] risk=set[enum]:[security,path-traversal,secret-leak,remote-execution] test=list[path]:[tests/test_bundle.py,tests/test_dockerfile.py,tests/test_execute_notebook.py,tests/test_slurm_template.py] evidence=list[path]:[src/dgx_slurm/bundle.py,src/dgx_slurm/templates/]
@mod connectivity kind=adapter owns=set[id]:[openvpn-session,ssh-transport,sftp-transfer,remote-log-reads] entry=list[path]:[src/dgx_slurm/vpn.py,src/dgx_slurm/ssh.py] deps=set[id]:[models] risk=set[enum]:[security,credentials,network,remote-execution] test=list[path]:[tests/test_vpn.py,tests/test_ssh.py] evidence=list[path]:[src/dgx_slurm/vpn.py,src/dgx_slurm/ssh.py]
@mod scheduling kind=adapter owns=set[id]:[slurm-submit,status,cancel,log-streaming] entry=list[path]:[src/dgx_slurm/slurm.py,src/dgx_slurm/streaming.py] deps=set[id]:[connectivity,models] risk=set[enum]:[remote-execution,state-mapping] test=list[path]:[tests/test_slurm.py,tests/test_streaming.py] evidence=list[path]:[src/dgx_slurm/slurm.py,src/dgx_slurm/streaming.py]
@mod persistence kind=support owns=set[id]:[local-job-metadata,reattach-lookup] entry=list[path]:[src/dgx_slurm/storage.py] deps=set[id]:[] risk=set[enum]:[filesystem,corrupt-state] test=list[path]:[tests/test_client.py] evidence=list[path]:[src/dgx_slurm/storage.py]
@mod examples kind=docs owns=set[id]:[usage,local-dry-run,cluster-smoke] entry=list[path]:[examples/] deps=set[id]:[orchestration] risk=set[enum]:[environment] test=list[path]:[tests/test_integration.py,tests/test_cluster_smoke.py] evidence=list[path]:[examples/README.md,examples/local_dry_run.py]

@surface dgx-client owner=orchestration kind=class visibility=public symbol="dgx_slurm.DGXClient" input="ovpn path and cluster username" returns=DGXClient throws=[DGXError] calls=[notebook-bundle-builder,slurm-scheduler,dgx-job] evidence=list[path]:[src/dgx_slurm/__init__.py,src/dgx_slurm/client.py] test=list[path]:[tests/test_client.py,tests/test_integration.py]
@surface dgx-job owner=orchestration kind=class visibility=public symbol="dgx_slurm.DGXJob" input="persisted or newly submitted SLURM job" returns=JobResult throws=[DGXError] calls=[slurm-scheduler,log-streamer] evidence=list[path]:[src/dgx_slurm/__init__.py,src/dgx_slurm/job.py] test=list[path]:[tests/test_job.py]
@surface public-models owner=models kind=export visibility=public symbol="dgx_slurm.Resources, JobState, JobStatus, JobResult" evidence=list[path]:[src/dgx_slurm/__init__.py,src/dgx_slurm/models.py] test=list[path]:[tests/test_models.py]
@surface notebook-bundle-builder owner=bundling kind=class visibility=module-public symbol="dgx_slurm.bundle.NotebookBundleBuilder" input="notebook, resources, project-scoped includes" returns=path risk=set[enum]:[security,path-traversal,secret-leak] evidence=list[path]:[src/dgx_slurm/bundle.py] test=list[path]:[tests/test_bundle.py]
@surface slurm-scheduler owner=scheduling kind=class visibility=module-public symbol="dgx_slurm.slurm.SlurmScheduler" input="SSHTransport and job identifiers" returns="job id or JobStatus" throws=[SchedulerError] evidence=list[path]:[src/dgx_slurm/slurm.py] test=list[path]:[tests/test_slurm.py]
@surface ssh-transport owner=connectivity kind=class visibility=module-public symbol="dgx_slurm.ssh.SSHTransport" input="host, credentials, paths, library-constructed commands" returns="remote command results or file data" throws=[SSHError] risk=set[enum]:[security,credentials,remote-execution] evidence=list[path]:[src/dgx_slurm/ssh.py] test=list[path]:[tests/test_ssh.py]

@resolver edit-public-api target=mod.orchestration intent=edit go=list[path]:[src/dgx_slurm/__init__.py,src/dgx_slurm/client.py,src/dgx_slurm/job.py,src/dgx_slurm/models.py,tests/test_client.py,tests/test_job.py,tests/test_models.py,tests/test_integration.py] use=list[enum]:[search,symbols,tests] verify=list[string]:["python -m pytest tests/test_client.py tests/test_job.py tests/test_models.py tests/test_integration.py"] requires=list[id]:[no-secret-persistence,connection-ownership]
@resolver edit-bundle-runner target=mod.bundling intent=edit go=list[path]:[src/dgx_slurm/bundle.py,src/dgx_slurm/templates/,tests/test_bundle.py,tests/test_dockerfile.py,tests/test_execute_notebook.py,tests/test_slurm_template.py] use=list[enum]:[search,tests] verify=list[string]:["python -m pytest tests/test_bundle.py tests/test_dockerfile.py tests/test_execute_notebook.py tests/test_slurm_template.py"] requires=list[id]:[safe-includes,partial-notebook,image-scoped-cleanup]
@resolver edit-connectivity target=mod.connectivity intent=edit go=list[path]:[src/dgx_slurm/vpn.py,src/dgx_slurm/ssh.py,tests/test_vpn.py,tests/test_ssh.py] use=list[enum]:[search,tests] verify=list[string]:["python -m pytest tests/test_vpn.py tests/test_ssh.py"] requires=list[id]:[ephemeral-vpn-credentials,strict-host-keys,no-secret-persistence]
@resolver edit-scheduling target=mod.scheduling intent=edit go=list[path]:[src/dgx_slurm/slurm.py,src/dgx_slurm/streaming.py,src/dgx_slurm/job.py,tests/test_slurm.py,tests/test_streaming.py,tests/test_job.py] use=list[enum]:[search,tests] verify=list[string]:["python -m pytest tests/test_slurm.py tests/test_streaming.py tests/test_job.py"] requires=list[id]:[terminal-state-contract,incremental-logs]
@resolver verify-locally target=flow.submit-and-wait intent=verify go=list[path]:[examples/local_dry_run.py,examples/experiment.ipynb,src/dgx_slurm/templates/execute_notebook.py] use=list[enum]:[tests,logs] verify=list[string]:["python -m pytest -m 'not cluster'","python examples/local_dry_run.py"] avoid=list[glob]:[tests/test_cluster_smoke.py] note="The dry run substitutes VPN, SSH, SLURM, and Docker but executes the shipped notebook runner."
@resolver verify-real-cluster target=flow.submit-and-wait intent=verify go=list[path]:[tests/test_cluster_smoke.py,examples/basic_usage.py,src/dgx_slurm/client.py] use=list[enum]:[tests,logs] verify=list[string]:["python -m pytest -m cluster -s"] requires=list[id]:[real-cluster-configuration] note="Opt-in only; requires VPN credentials, network access, OpenVPN, configured host constants, SLURM, Docker, and a GPU node."

@flow submit-and-wait trigger="DGXClient.submit followed by await DGXJob.wait" path=[validate-notebook,connect-vpn,connect-ssh,build-bundle,upload-bundle,sbatch,persist-job,stream-logs,poll-status,download-outputs] fail={invalid-input:BundleError,vpn:VPNError,ssh:SSHError,scheduler:SchedulerError} inv=[safe-includes,no-secret-persistence,terminal-state-contract,incremental-logs] test=list[path]:[tests/test_integration.py] evidence=list[path]:[src/dgx_slurm/client.py,src/dgx_slurm/job.py]
@flow execute-notebook trigger="SLURM runs generated runImage.slurm" path=[docker-build,docker-run,execute-cells,write-executed-notebook,remove-job-image] fail={build:nonzero,cell-error:nonzero} inv=[partial-notebook,image-scoped-cleanup] test=list[path]:[tests/test_execute_notebook.py,tests/test_slurm_template.py] evidence=list[path]:[src/dgx_slurm/templates/runImage.slurm,src/dgx_slurm/templates/execute_notebook.py]

@contract bundle-layout type=file owner=bundling source=src/dgx_slurm/bundle.py fields=list[id]:[payload,runner,outputs,logs,Dockerfile,runImage.slurm,manifest.json] risk=set[enum]:[security,secret-leak] test=list[path]:[tests/test_bundle.py,tests/test_dockerfile.py]
@contract local-job-store type=file owner=persistence source=src/dgx_slurm/storage.py fields=list[id]:[job-id,job-name,remote-job-dir] risk=set[enum]:[corrupt-state] test=list[path]:[tests/test_client.py]
@contract slurm-cli type=cli owner=scheduling source=src/dgx_slurm/slurm.py fields=list[id]:[sbatch,squeue,sacct,scancel] risk=set[enum]:[remote-execution] test=list[path]:[tests/test_slurm.py]

@inv safe-includes scope=bundling severity=critical rule="Included files must resolve inside project_root; credential-like suffixes and ignored directories must never enter the uploaded payload." evidence=list[path]:[src/dgx_slurm/bundle.py,tests/test_bundle.py]
@inv no-secret-persistence scope=orchestration severity=critical rule="Passwords, VPN contents, private-key material, authentication temp paths, and environment dumps must not be persisted, bundled, or exposed in errors." evidence=list[path]:[src/dgx_slurm/errors.py,src/dgx_slurm/storage.py,src/dgx_slurm/bundle.py,tests/test_bundle.py,tests/test_vpn.py]
@inv ephemeral-vpn-credentials scope=connectivity severity=critical rule="OpenVPN credentials live only in memory and in a temporary 0700 directory with a 0600 auth file, removed after connection success or failure." evidence=list[path]:[src/dgx_slurm/vpn.py,tests/test_vpn.py]
@inv strict-host-keys scope=connectivity severity=high rule="SSH must load known hosts and reject unknown host keys by default." evidence=list[path]:[src/dgx_slurm/ssh.py,tests/test_ssh.py]
@inv connection-ownership scope=connectivity severity=high rule="Disconnect must terminate only the OpenVPN process started by this library; an already reachable external VPN is not owned." evidence=list[path]:[src/dgx_slurm/vpn.py,tests/test_vpn.py]
@inv incremental-logs scope=scheduling severity=medium rule="Remote stdout and stderr are read from independent byte offsets so streamed chunks are accumulated and echoed at most once." evidence=list[path]:[src/dgx_slurm/streaming.py,tests/test_streaming.py]
@inv terminal-state-contract scope=scheduling severity=high rule="DGXJob.wait returns only after a terminal JobState and performs one final log poll before optional output download." evidence=list[path]:[src/dgx_slurm/job.py,src/dgx_slurm/models.py,tests/test_job.py]
@inv partial-notebook scope=bundling severity=high rule="The runner always writes the executed or partially executed notebook, including when a cell raises an execution error." evidence=list[path]:[src/dgx_slurm/templates/execute_notebook.py,tests/test_execute_notebook.py]
@inv image-scoped-cleanup scope=bundling severity=high rule="SLURM cleanup removes only the image tagged for the current job, preserves the job exit code, and never runs docker system prune." evidence=list[path]:[src/dgx_slurm/templates/runImage.slurm,tests/test_slurm_template.py]

@task establish-aicp owner=orchestration status=done goal="Add a repository-level AICP semantic and navigation manifest." touch=list[path]:[AICP.aicp] avoid=list[glob]:[]

@risk placeholder-cluster-config level=high scope=set[id]:[orchestration,examples] mitigation="Replace DEFAULT_SSH_HOST and related deployment constants with the real cluster values before real-cluster use." evidence=list[path]:[src/dgx_slurm/client.py,examples/README.md]
@risk remote-command-boundary level=high scope=set[id]:[connectivity,scheduling] mitigation="Keep remote commands library-constructed and shell-quote every dynamic path or identifier." evidence=list[path]:[src/dgx_slurm/ssh.py,src/dgx_slurm/slurm.py,src/dgx_slurm/client.py]
@risk cluster-test-environment level=medium scope=set[id]:[examples,scheduling] mitigation="Keep real-cluster smoke tests opt-in and use unit/integration tests plus local_dry_run for routine validation." evidence=list[path]:[tests/test_cluster_smoke.py,examples/README.md]
@risk stale-context level=medium scope=set[id]:[global] mitigation="Update AICP when public surfaces, module boundaries, bundle contracts, cluster flow, invariants, or verification commands change."
