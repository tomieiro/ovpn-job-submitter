@aicp v=semver:0.3.0 id=dgx-slurm kind=library summary="Python library for submitting Jupyter notebooks to a SLURM-managed DGX cluster over OpenVPN, SSH, and Docker."
@stack lang=set[enum]:[python,bash,dockerfile,yaml] runtime=set[enum]:[cpython,openvpn,ssh,slurm,docker,jupyter] infra=set[enum]:[dgx,cuda,github-actions] package=list[path]:[pyproject.toml] lock=list[path]:[]
@agent read=list[atom]:[@aicp,@stack,@cmd,@mod,@surface,@resolver,@flow,@contract,@inv,@task,@risk] verify=bool:true update_on_arch_change=bool:true max_context_ratio=float:0.05 mode=guided
@avoid paths=list[glob]:[.git/**,.venv/**,.pytest_cache/**,__pycache__/**,*.egg-info/**,build/**,dist/**,.dgx-results/**,examples/.dgx-results/**] reason="Generated, cached, environment, or downloaded-result content."

@cmd setup "python -m pip install -e '.[dev]'"
@cmd test "python -m pytest"
@cmd test-unit "python -m pytest -m 'not cluster'"
@cmd local-smoke "python examples/local_dry_run.py"
@cmd cluster-smoke "DGX_SMOKE_OVPN=/path/client.ovpn DGX_SMOKE_USERNAME=user python -m pytest -m cluster -s"

